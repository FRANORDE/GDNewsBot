# Copy this file to ".env" and fill in your real Discord webhook URLs.
# ".env" is listed in .gitignore and will never be committed to GitHub.

# ---- Dashword bot ----
DASHWORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY
DASHWORD_PING_MESSAGE=@everyone

# ---- Reddit bot ----
REDDIT_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY
REDDIT_PING_MESSAGE=
REDDIT_USER_AGENT=DashwordDiscordBot/1.0 (by /u/YOUR_REDDIT_USERNAME)

# ---- Pointercrate bot ----
POINTERCRATE_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY
POINTERCRATE_PING_MESSAGE=
